# ── Deployment / test credentials (contracts/) — ETHEREUM SEPOLIA ────────────
# A funded Sepolia account: needs test ETH for gas, and test USDC to fund
# escrow. (1_deploy.ts / test scripts read this file.)
CRE_ETH_PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY

# Ethereum Sepolia RPC endpoint (Alchemy / Infura).
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# USDC on Ethereum Sepolia (default is prefilled below).
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Populated after deploy. `1_deploy.ts` also writes it into cre/config.json.
CONTRACT_ADDRESS=

# Third arbitration signer. Defaults to the deployer if left blank.
ARBITRATOR_ADDRESS=

# Chainlink CRE KeystoneForwarder for Ethereum Sepolia (required to deploy).
# https://docs.chain.link/cre/guides/workflow/using-evm-client/forwarder-directory-ts
FORWARDER_ADDRESS=0x15fC6ae953E024d975e77382eEeC56A9101f9F88

# Optional: a second party's key, for a full 2-of-3 arbitration test.
SECOND_PRIVATE_KEY=

# Optional: Etherscan API key, for contract verification.
ETHERSCAN_API_KEY=
