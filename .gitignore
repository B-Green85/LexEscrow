# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Rust / Tauri ──────────────────────────────────────────────
src-tauri/target/
target/
**/*.rs.bk
*.pdb

# ── SQLite (local runtime DB, never committed) ────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
src-tauri/lexescrow.db*

# ── Secrets & environment ─────────────────────────────────────
.env
.env.*
!.env.example
# Demo build config — no secrets, only mock-adapter endpoints and the demo
# flag that routes eSign to the mock provider. Tracked deliberately: demo mode
# depends on it, and a missing copy would silently fall back to real DocuSign.
!.env.demo
secrets.yaml
cre/secrets.yaml
**/config.json
!**/config.json.example
.secrets

# ── Private keys & certificates ───────────────────────────────
# Blanket-deny key material by extension so a real DocuSign RSA key, a deployer
# key export or a TLS cert dropped into the tree is never stageable by accident.
*.pem
*.key
*.p12
*.pfx
*private*
# One deliberate exception: a throwaway 2048-bit RSA key generated solely for
# the DocuSign unit tests (see the comment at src-tauri/src/docusign.rs:777).
# `include_str!` resolves it at compile time, so a clone without it fails to
# build the test target — it has to stay tracked.
!src-tauri/test-fixtures/docusign_test_key.pem

# ── Reference implementations (kept locally as reference only) ────
cre-templates-main/
reference/

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
audit-log.jsonl

# ── Test / coverage ───────────────────────────────────────────
coverage/
.vitest/

# CRE workflow build temp artifacts
cre/.cre_build_tmp*
cre/dist/

# Large source images only — the generated app icons in Assets/ ARE tracked
