# LexEscrow demo build (`vite --mode demo`).
#
# Routes every external seam at the local mock adapters started by
# demo/scripts/run_demo.sh, so the full seven-asset-class flow runs offline.
# Everything between those seams — ArtifactGuard, LexGuard, the audit chain,
# the condition engine, the release paths — runs the production code path.

VITE_DEMO_MODE=true

# Mock adapter endpoints (demo/mock-adapters/index.ts).
VITE_CALBAR_BASE_URL=http://localhost:3001
VITE_METRC_BASE_URL=http://localhost:3002
VITE_DOCUSIGN_BASE_URL=http://localhost:3003
