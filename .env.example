# LexEscrow notification layer (Rust backend). Copy to `.env`.
# Post-settlement client notification only — never sent before funds move.
# A channel with no configuration is reported as "skipped" (recorded in the
# audit log), so the app runs fine without these set.

# ── Email (SMTP via lettre) ──────────────────────────────────────────
# Leave SMTP_HOST empty to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourfirm.example
LAW_FIRM_NAME="Your Law Firm"

# ── SMS (Twilio via reqwest) ─────────────────────────────────────────
# Leave TWILIO_ACCOUNT_SID / TWILIO_FROM empty to skip SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
# AnchorRegistry (Sepolia) — AnchorReceipt on-chain document-hash anchoring
ANCHOR_REGISTRY_ADDRESS=
